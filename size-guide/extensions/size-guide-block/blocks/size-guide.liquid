{%- liquid
  assign c1 = app.metafields.size_guide.config.value
  assign c2 = app.metafields['$app:size_guide'].config.value
  assign c3 = app.metafields['app--436162592769--size_guide'].config.value
  assign cfg = c1
  assign cfg_src = 'p1'
  if cfg == blank
    assign cfg = c2
    assign cfg_src = 'p2'
  endif
  if cfg == blank
    assign cfg = c3
    assign cfg_src = 'p3'
  endif
  if cfg == blank
    assign cfg_src = 'none'
  endif
-%}
{{ 'size-guide.css' | asset_url | stylesheet_tag }}

<div class="sg-root" data-sg-root>
  <button type="button" class="sg-btn sg-btn--{{ block.settings.style }}" data-sg-open
    style="--sg-btn-bg:{{ block.settings.button_color }};--sg-btn-fg:{{ block.settings.button_text_color }}">
    {{- block.settings.text -}}
  </button>
  <span class="sg-reco" data-sg-reco hidden></span>

  <script type="application/json" data-sg-data>
  {
    "product": {
      "id": {{ product.id }},
      "title": {{ product.title | json }},
      "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | json }}{% else %}null{% endif %},
      "images": [{% for img in product.images limit: 4 %}{{ img | image_url: width: 160 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "tags": {{ product.tags | json }},
      "collections": [{% for c in product.collections %}{{ c.handle | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "options": {{ product.options | json }},
      "variants": [{% for v in product.variants %}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
    },
    "config": {% if cfg != blank %}{{ cfg | json }}{% else %}null{% endif %},
    "configSource": {{ cfg_src | json }},
    "i18n": {
      "title": {{ block.settings.modal_title | json }},
      "currency": {{ cart.currency.iso_code | json }}
    }
  }
  </script>
</div>

<script src="{{ 'size-guide.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Guida Taglie",
  "target": "section",
  "templates": ["product"],
  "settings": [
    { "type": "text", "id": "text", "label": "Testo del pulsante", "default": "📏 Guida Taglie" },
    { "type": "select", "id": "style", "label": "Stile pulsante", "default": "link",
      "options": [
        { "value": "link", "label": "Link sottolineato" },
        { "value": "solid", "label": "Pieno" },
        { "value": "outline", "label": "Contorno" }
      ] },
    { "type": "color", "id": "button_color", "label": "Colore pulsante", "default": "#111111" },
    { "type": "color", "id": "button_text_color", "label": "Colore testo pulsante", "default": "#ffffff" },
    { "type": "text", "id": "modal_title", "label": "Titolo finestra", "default": "Guida alle taglie" }
  ]
}
{% endschema %}
